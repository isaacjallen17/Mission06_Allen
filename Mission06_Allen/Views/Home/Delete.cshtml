@model Movie




<main>
	<style>
        form button {
            color: #fff;
            display: inline-block;
            background: #555;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
            font-size: 16px;
            text-align: center;
            text-decoration: none;
            text-underline-offset: revert;
            height: 40px;
        }

        /* Specific color for button */
        form button.scaary {
            background: #f00;
        }

            form button.scaary:hover {
                background: #c00;
            }

        /* Specific color for a tag */
        form button:hover {
            background: #333;
        }

	</style>
    <form method="post" style="text-align: center">
        <h1>Are You Sure You Want To Delete @Model.Title</h1><br /><br />
		<button asp-controller="Home" asp-action="MovieList" >Cancel</button>
		<button class="scaary" type="submit">Delete</button>
	</form>
</main>