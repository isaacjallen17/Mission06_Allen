@model Movie

<main>
    <h1>New Movie Form</h1>
    <form method="post">
        <div asp-validation-summary="All"></div>
        <input asp-for="MovieId" hidden />
        <label asp-for="CategoryId">Select A Category</label>
        <select asp-for="CategoryId">
            @foreach (Category c in ViewBag.categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
        <br />
        <label asp-for="Title">Title</label>
        <input asp-for="Title" />
        <br />
        <label asp-for="Year">Year</label>
        <input asp-for="Year" value=""/>
        <br />
        <label asp-for="Director">Director</label>
        <input asp-for="Director" />
        <br />
        <label asp-for="Rating">Rating</label>
        <select asp-for="Rating">
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG13">PG-13</option>
            <option value="R">R</option>
        </select>
        <br />
        <label asp-for="Edited">Edited</label>
        <input asp-for="Edited" type="checkbox" value="true" />
        <br />
        <label asp-for="LentTo">Lent To</label>
        <input asp-for="LentTo"/>
        <br />
        <label asp-for="CopiedToPlex">Is Movie Copied To Plex?</label>
        <input asp-for="CopiedToPlex" type="checkbox" value="true" />
        <br />
        <label asp-for="Notes">Notes</label>
        <input maxlength="25" asp-for="Notes"/>
        <br />
        <button type="submit">Submit</button><br /><br /><br />
    </form>
</main>
